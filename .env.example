# Copy to .env and fill in. .env is gitignored - never commit real credentials.
# Create the roles and database first: scripts/db/setup-roles.sql
# Why there are two datasources: docs/persistence.md

SPRING_PROFILES_ACTIVE='dev'


# Which seed folder under db/seed the database starts with: its people, groups
# and registrations. Production has none.
STAFF_ENVIRONMENT='dev'


# Flyway, at startup. Owns the schema, holds DDL rights.
FLYWAY_URL='jdbc:postgresql://localhost:5432/staff'
FLYWAY_USERNAME='staff_migrator'
FLYWAY_PASSWORD='changeme_migrator'


# The running app. DML only.
# Behind PgBouncer, use its port and add prepareThreshold=0 - docs/scaling.md
DB_URL='jdbc:postgresql://localhost:5432/staff'
DB_USERNAME='staff_app'
DB_PASSWORD='changeme_app'


# The port the service listens on. sgt's FIELD_AGENTS_URL expects 8082.
SERVER_PORT='8082'


# The identifier the directory API is registered under in this environment's
# seed. Services read it with a token issued for it.
STAFF_DIRECTORY_AUDIENCE='staff-directory-api-dev'


# The URL tokens name as their issuer. Services validating tokens point at it.
STAFF_ISSUER='http://localhost:8082'


# The origins the frontends' browser calls come from, sgt's and poi's,
# separated by commas. Where a login or logout returns to is part of each
# client's registration, seeded per environment.
STAFF_WEB_ORIGINS='http://localhost:4200,http://localhost:4201'


# The RSA key pair tokens are signed with. Create it once with:
#   mkdir -p keys
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/signing-private.pem
#   openssl pkey -in keys/signing-private.pem -pubout -out keys/signing-public.pem
STAFF_SIGNING_PRIVATE_KEY_PATH='keys/signing-private.pem'
STAFF_SIGNING_PUBLIC_KEY_PATH='keys/signing-public.pem'


# Whether the OpenAPI document and the Swagger UI are served.
API_DOCS_ENABLED='true'
